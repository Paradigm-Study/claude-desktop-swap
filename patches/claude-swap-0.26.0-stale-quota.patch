+def _decision_usage(
+    entries: dict[str, UsageEntry], current: str, now: float
+) -> dict[str, dict | str | None]:
+    """Do not mistake an old usage lower bound for active-account health."""
+    usage = {num: entry.decision_value() for num, entry in entries.items()}
+    active = entries.get(current)
+    if (
+        active is not None
+        and active.sentinel is None
+        and active.last_error == "http-429"
+        and active.fetched_at is not None
+        and now - active.fetched_at > STALE_OK_S
+    ):
+        # A throttled usage API can freeze a low reading while inference
+        # consumes the remaining quota. Use the existing unhealthy failover
+        # path, but only toward a freshly measured peer; rotating among stale
+        # peers would merely trade one unknown account for another. The store
+        # still retains its display data and honors the server's backoff.
+        usage[current] = None
+        for num, value in usage.items():
+            if isinstance(value, dict) and not entries[num].fresh(now):
+                usage[num] = None
+    return usage
 
 
